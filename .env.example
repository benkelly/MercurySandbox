# Copy to .env and fill in. This file is read by Terraform (via TF_VAR_* in
# terraform/main.tf using the dotenv pattern below) and by run-sandbox.sh.
# Never commit .env.

# Master key clients use to talk to LiteLLM (make one up, treat it like a password)
LITELLM_MASTER_KEY=sk-local-change-me

# Upstream provider keys, only LiteLLM ever sees these
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Git identity for sandbox commits
SANDBOX_GIT_NAME="agent-sandbox"
SANDBOX_GIT_EMAIL="agents@example.com"

# Fine-grained PAT or deploy token scoped to ONLY the repos agents may push to.
# Branch pushes only, protect main in the repo settings.
SANDBOX_GIT_TOKEN=
