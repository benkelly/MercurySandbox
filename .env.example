# Copy to .env and fill in. Read by bin/mercury and by docker compose (as the
# compose --env-file), and passed to the mercury controller container.
# Never commit .env.

# ---- required ---------------------------------------------------------------

# Master key clients use to talk to the gateway (make one up, treat it like a
# password; openssl rand -hex 24 is a fine generator)
LITELLM_MASTER_KEY=sk-local-change-me

# Upstream provider keys, only the gateway ever sees these
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# ---- sandboxes --------------------------------------------------------------

# Git identity for sandbox commits
SANDBOX_GIT_NAME=mercury-sandbox
SANDBOX_GIT_EMAIL=agents@example.com

# Fine-grained PAT or deploy token scoped to ONLY the repos agents may push to.
# Branch pushes only, protect main in the repo settings.
SANDBOX_GIT_TOKEN=

# Model used when a sandbox is spawned without one (a model_name from
# gateway/config.yaml)
# SANDBOX_DEFAULT_MODEL=cheap-default

# Sandbox image. The default builds sandbox/ locally on `mercury up`; set the
# published image to pull instead (what the Home Assistant add-on does).
# SANDBOX_IMAGE=ghcr.io/benkelly/mercury-sandbox:latest

# Per-sandbox caps
# SANDBOX_MEMORY=2g
# SANDBOX_CPUS=2

# ---- ports ------------------------------------------------------------------
# Both default to loopback. Remote access rides Tailscale; only widen these if
# you know what is listening on the other side.

# GATEWAY_BIND=127.0.0.1
# GATEWAY_PORT=4000

# mercuryd (the API and web page). Set MERCURY_API_TOKEN if it ever leaves
# loopback: whoever reaches it controls Docker on this host.
# MERCURY_BIND=127.0.0.1
# MERCURY_PORT=5004
# MERCURY_API_TOKEN=

# ---- optional ---------------------------------------------------------------

# Cloudflare Tunnel token (Zero Trust dashboard -> Networks -> Tunnels). Leave
# empty and cloudflared is never started.
CLOUDFLARE_TUNNEL_TOKEN=
