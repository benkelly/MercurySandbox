#!/usr/bin/env bash
# mercury — CLI front door for MercurySandbox.
# A safe playground for autonomous coding agents.
set -euo pipefail

MERCURY_ROOT="${MERCURY_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export MERCURY_ROOT

# shellcheck source=lib/common.sh
source "$MERCURY_ROOT/lib/common.sh"
# shellcheck source=lib/stack.sh
source "$MERCURY_ROOT/lib/stack.sh"
# shellcheck source=lib/sandbox.sh
source "$MERCURY_ROOT/lib/sandbox.sh"

[ $# -gt 0 ] || set -- help

# Run any command on a remote Docker host instead of locally:
#   MERCURY_HOST=you@host mercury status     or     mercury -H you@host status
# Assumes this repo is checked out on the remote at MERCURY_REMOTE_DIR
# (default: MercurySandbox, relative to the remote home directory).
HOST="${MERCURY_HOST:-}"
if [ "${1:-}" = "-H" ] || [ "${1:-}" = "--host" ]; then
  HOST="${2:?usage: mercury -H <ssh-host> <command> ...}"
  shift 2
  [ $# -gt 0 ] || set -- help
fi
if [ -n "$HOST" ]; then
  REMOTE_DIR="${MERCURY_REMOTE_DIR:-MercurySandbox}"
  # -t keeps interactive commands (sandbox TUI, exec) working over SSH
  exec ssh -t "$HOST" "cd $(printf '%q' "$REMOTE_DIR") && ./bin/mercury $(printf '%q ' "$@")"
fi

usage() {
  cat <<'USAGE'
mercury — a safe playground for autonomous coding agents

Stack (docker compose: gateway, controller, optional tunnel):
  mercury up [--pull]             build/pull and start the stack + sandbox image
  mercury down [--force]          stop and remove the stack (refuses while sandboxes run)
  mercury stop                    stop the stack, keep it for the next up
  mercury status                  stack containers and running sandboxes
  mercury doctor                  read-only health checks on the whole stack
  mercury models                  list models the gateway exposes
  mercury logs <gateway|mercury|cloudflared|sandbox-name>

Sandboxes (throwaway opencode containers, one repo and one task each):
  mercury sandbox <git-url> [task] [model]
                                  spawn one; no task = interactive TUI
  mercury sandbox -d ...          spawn in the background (see sandbox --help)
  mercury ps                      list running sandboxes
  mercury exec <name> [cmd...]    shell into a running sandbox (default: bash)
  mercury kill <name>             stop a sandbox (it self-deletes)

Other:
  mercury serve                   run mercuryd, the HTTP API and web page
  mercury install <hermes|webui|ocm>
                                  run the matching native install script
  mercury version                 print the version
  mercury help                    show this help

Remote:
  Every command also runs against a remote Docker host over SSH:
    mercury -H you@host status
    MERCURY_HOST=you@host mercury ps
  Requires this repo checked out on the remote, path set by MERCURY_REMOTE_DIR
  (default: ~/MercurySandbox).
USAGE
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  up) stack_up "$@" ;;
  down) stack_down "$@" ;;
  stop) stack_stop "$@" ;;
  status) stack_status ;;
  doctor) stack_doctor ;;
  models) stack_models ;;
  logs)
    target="${1:?usage: mercury logs <gateway|mercury|cloudflared|sandbox-name>}"
    shift
    case "$target" in
      gateway | mercury | cloudflared)
        load_env
        compose logs -f "$@" "$target"
        ;;
      *) docker logs -f "$@" "$target" ;;
    esac
    ;;
  sandbox) sandbox_run "$@" ;;
  ps)
    docker ps --filter label=mercury.sandbox \
      --format 'table {{.Names}}\t{{.Status}}\t{{.Label "mercury.branch"}}\t{{.Label "mercury.repo"}}'
    ;;
  exec)
    name="${1:?usage: mercury exec <name> [cmd...]}"
    shift
    if [ $# -eq 0 ]; then
      docker exec -it "$name" bash
    else
      docker exec -it "$name" "$@"
    fi
    ;;
  kill) docker stop -t 10 "${1:?usage: mercury kill <name>}" ;;
  serve)
    load_env
    exec python3 "$MERCURY_ROOT/mercuryd/server.py" "$@"
    ;;
  install)
    target="${1:-}"
    case "$target" in
      hermes) "$MERCURY_ROOT/scripts/install-hermes.sh" ;;
      webui) "$MERCURY_ROOT/scripts/install-webui.sh" ;;
      ocm) "$MERCURY_ROOT/scripts/install-ocm.sh" ;;
      *)
        echo "usage: mercury install <hermes|webui|ocm>" >&2
        exit 1
        ;;
    esac
    ;;
  version | --version | -v) mercury_version; echo ;;
  help | -h | --help) usage ;;
  *)
    echo "mercury: unknown command '$cmd'" >&2
    usage >&2
    exit 1
    ;;
esac
