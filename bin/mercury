#!/usr/bin/env bash
# mercury — CLI front door for MercurySandbox.
# A safe playground for autonomous coding agents.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

[ $# -gt 0 ] || set -- help

# Run any command on a remote Docker host instead of locally:
#   MERCURY_HOST=you@host mercury status     or     mercury -H you@host status
# Assumes this repo is checked out on the remote at MERCURY_REMOTE_DIR
# (default: MercurySandbox, relative to the remote home directory).
HOST="${MERCURY_HOST:-}"
if [ "${1:-}" = "-H" ] || [ "${1:-}" = "--host" ]; then
  HOST="${2:?usage: mercury -H <ssh-host> <command> ...}"
  shift 2
  [ $# -gt 0 ] || set -- help
fi
if [ -n "$HOST" ]; then
  REMOTE_DIR="${MERCURY_REMOTE_DIR:-MercurySandbox}"
  # -t keeps interactive commands (sandbox TUI, exec) working over SSH
  exec ssh -t "$HOST" "cd $(printf '%q' "$REMOTE_DIR") && ./bin/mercury $(printf '%q ' "$@")"
fi

usage() {
  cat <<'EOF'
mercury — a safe playground for autonomous coding agents

Usage:
  mercury up                      terraform init + apply (gateway, network, sandbox image)
  mercury plan                    terraform plan, see what up would do
  mercury down                    terraform destroy, tear the stack down
  mercury sandbox <git-url> [task] [model]
                                  spawn a throwaway opencode sandbox
  mercury ps                      list running sandbox containers
  mercury logs <container>        follow a sandbox's output
  mercury exec <container> [cmd...]
                                  shell into a running sandbox (default: bash)
  mercury kill <container>        stop a sandbox (it self-deletes)
  mercury models                  list models exposed by the LiteLLM gateway
  mercury status                  show the gateway container status
  mercury install <hermes|webui|ocm>
                                  run the matching install script
  mercury help                    show this help

Remote:
  Every command also runs against a remote Docker host over SSH, so you can
  drive it from a laptop on the tailnet:

    mercury -H you@host status
    MERCURY_HOST=you@host mercury ps

  Requires this repo checked out on the remote, path set by MERCURY_REMOTE_DIR
  (default: ~/MercurySandbox).
EOF
}

tf() {
  if [ -f "$ROOT/.env" ]; then
    # shellcheck disable=SC1091
    source "$ROOT/scripts/tf-env.sh"
  fi
  terraform -chdir="$ROOT/terraform" "$@"
}

load_env() {
  if [ -f "$ROOT/.env" ]; then
    set -a
    # shellcheck disable=SC1091
    source "$ROOT/.env"
    set +a
  fi
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  up)
    tf init -input=false
    tf apply "$@"
    ;;
  plan)
    tf init -input=false
    tf plan "$@"
    ;;
  down)
    tf destroy "$@"
    ;;
  sandbox)
    "$ROOT/sandbox/run-sandbox.sh" "$@"
    ;;
  ps)
    docker ps --filter label=mercury.sandbox --format 'table {{.Names}}\t{{.Status}}\t{{.RunningFor}}'
    ;;
  logs)
    docker logs -f "${1:?usage: mercury logs <container>}"
    ;;
  exec)
    name="${1:?usage: mercury exec <container> [cmd...]}"
    shift
    if [ $# -eq 0 ]; then
      docker exec -it "$name" bash
    else
      docker exec -it "$name" "$@"
    fi
    ;;
  kill)
    docker stop "${1:?usage: mercury kill <container>}"
    ;;
  models)
    load_env
    resp="$(curl -fsS http://localhost:4000/v1/models \
      -H "Authorization: Bearer ${LITELLM_MASTER_KEY:-}")"
    if command -v jq >/dev/null 2>&1; then
      jq -r '.data[].id' <<<"$resp"
    else
      printf '%s\n' "$resp"
    fi
    ;;
  status)
    docker ps --filter name=gateway --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
    ;;
  install)
    target="${1:-}"
    case "$target" in
      hermes) "$ROOT/scripts/install-hermes.sh" ;;
      webui) "$ROOT/scripts/install-webui.sh" ;;
      ocm) "$ROOT/scripts/install-ocm.sh" ;;
      *)
        echo "usage: mercury install <hermes|webui|ocm>" >&2
        exit 1
        ;;
    esac
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    echo "mercury: unknown command '$cmd'" >&2
    usage >&2
    exit 1
    ;;
esac
